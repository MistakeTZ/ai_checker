# Required
ANTHROPIC_API_KEY=sk-ant-...
TELEGRAM_BOT_TOKEN=123456:ABC...        # from @BotFather (not needed for check.py)

# Claude
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low                        # low | medium | high | xhigh | max (empty = model default)
CLAUDE_FALLBACKS=true                    # re-run on a fallback model if a safety classifier declines

# Formula
FIRST_SCREEN_WEIGHT=0.6                  # first screen vs the rest of the page (0.6 = 60/40)
DESKTOP_WEIGHT=0.5                       # desktop vs mobile in the site score

# Rendering
MAX_SCREENS_DESKTOP=8                    # long pages are sampled evenly down to the footer
MAX_SCREENS_MOBILE=12
MOBILE_DEVICE=iPhone 17                  # any Playwright device name
BROWSER_LOCALE=en-US
CAPTURE_TIMEOUT=120                      # seconds per device
ANALYSIS_TIMEOUT=300

# Bot limits
MAX_CONCURRENT_CHECKS=2
CHECKS_PER_USER_PER_HOUR=10              # 0 = unlimited
ALLOWED_USERS=                           # comma-separated Telegram user IDs; empty = everyone
ALLOW_PRIVATE_URLS=false                 # true only for local testing (disables the SSRF guard)

DATA_DIR=data                            # results.jsonl and ratings.jsonl
LOG_LEVEL=INFO
